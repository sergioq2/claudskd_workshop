# Copia este archivo como .env y completa los valores.

# Obligatorio: tu API key de https://platform.claude.com
ANTHROPIC_API_KEY=

# Muy recomendado: token gratuito de datos.gov.co (perfil > Developer Settings).
# Sin él, el portal limita mucho las peticiones y en un taller con 30 personas se satura.
SOCRATA_APP_TOKEN=

# Opcional: alertas por Telegram. Crea un bot con @BotFather y obtén tu chat_id
# escribiéndole a tu bot y abriendo https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: límites y modelo
PRESUPUESTO_USD=2
MAX_TURNOS=40
MODELO_CLAUDE=
